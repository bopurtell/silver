(executable
 (name main)
 (public_name silver-workspace)
 (package hardcaml_workbench)
 (libraries
  async
  core
  core_unix.command_unix
  hardcaml_workbench_native_http
  hardcaml_workbench_protocol
  hardcaml_workbench_workspaces)
 (preprocess
  (pps ppx_jane))
 (lint
  (pps ppx_js_style)))

(install
 (package hardcaml_workbench)
 (section bin)
  (files (main.exe as hardcaml-workbench-workspace)))

(rule
 (alias runtest)
 (deps test_add_workspace.py)
 (action (run python3 -B %{dep:test_add_workspace.py} %{exe:main.exe})))
