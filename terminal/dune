; PTY drives the actual silver argv[0] launch path with a controlled renderer.
(rule
 (alias runtest)
 (deps test_startup_entry_pty.py ip_starter_fixture.py ../test/support/__init__.py
  ../test/support/screen.py ../test/support/terminal.py)
 (action (run python3 -B %{dep:test_startup_entry_pty.py} %{exe:main.exe})))

