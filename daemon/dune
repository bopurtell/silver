  (pps ppx_jane))
 (lint
  (pps ppx_js_style)))

(library
 (name server_host)
 (modules server_host)
 (libraries
  async
  cohttp-async
  core
  core_unix.command_unix
  silver_adapters
  silver_backend
  silver_native_http
  silver_protocol
  silver_rpc_server)
 (preprocess
  (pps ppx_jane))
