(library
 (name hardcaml_workbench_rpc_server)
 (modules rpc_server)
 (libraries
  async
  cohttp-async
  core
  hardcaml_workbench_backend
  hardcaml_workbench_protocol)
 (preprocess
  (pps ppx_jane))
 (lint
  (pps ppx_js_style)))

(library
 (name server_host)
 (modules server_host)
 (libraries
  async
  cohttp-async
  core
  core_unix.command_unix
  hardcaml_workbench_adapters
  hardcaml_workbench_backend
  hardcaml_workbench_native_http
  hardcaml_workbench_protocol
  hardcaml_workbench_rpc_server)
 (preprocess
  (pps ppx_jane))
 (lint
  (pps ppx_js_style)))

(executable
 (name main)
 (modules main)
 (public_name silver-daemon)
 (package hardcaml_workbench)
 (libraries core async core_unix.command_unix server_host)
 (preprocess (pps ppx_jane)))

(install
 (package hardcaml_workbench)
 (section bin)
 (files (main.exe as hardcaml-workbench-daemon)))
