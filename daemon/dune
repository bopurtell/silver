  (pps ppx_js_style)))

(executable
 (name main)
 (modules main)
 (public_name silver-daemon)
 (package silver)
 (libraries core async core_unix.command_unix server_host)
 (preprocess (pps ppx_jane)))

(install
 (package silver)
 (section bin)
 (files (main.exe as hardcaml-workbench-daemon)))
