(library
 (name silver_setup)
 (modules
   asic_adoption
   bluespec_scaffold
   bluespec_template
  config_migration
  initialization
  no_clobber
  project_discovery
  simulation_setup)
 (libraries
  core
  core_unix
  core_unix.filename_unix
  core_unix.signal_unix
  core_unix.sys_unix
  silver_adapters
  silver_project_integration
   silver_protocol
   yojson)
 (preprocess
  (pps ppx_jane))
 (lint
  (pps ppx_js_style)))

(executable
 (name embed_bluespec_template)
 (modules embed_bluespec_template))

; Keep source and binary installations in sync by compiling the editable example
; into the native CLI. Do not include Bazel's generated outputs.
(rule
 (targets bluespec_template.ml)
 (deps
  (:template
   ../examples/bluespec_classic/.bazelrc
   ../examples/bluespec_classic/.gitignore
   ../examples/bluespec_classic/BUILD.bazel
   ../examples/bluespec_classic/Counter.bs
   ../examples/bluespec_classic/MODULE.bazel
   ../examples/bluespec_classic/README.md
   ../examples/bluespec_classic/bench.cpp
   ../examples/bluespec_classic/checker.rs
   ../examples/bluespec_classic/simulation.bzl
   ../examples/bluespec_classic/simulation_provider.py))
 (action
  (with-stdout-to %{targets}
   (run %{exe:embed_bluespec_template.exe} %{template}))))

(executable
 (name main)
 (modules main)
 (public_name silver-init)
 (package silver)
 (libraries core core_unix.command_unix silver_setup)
 (preprocess
  (pps ppx_jane))
 (lint
  (pps ppx_js_style)))

(executable
 (name simulation_main)
 (modules simulation_main)
 (public_name silver-simulation-setup)
 (package silver)
 (libraries core core_unix.command_unix silver_setup)
 (preprocess
  (pps ppx_jane))
 (lint
  (pps ppx_js_style)))

(install
 (package silver)
 (section bin)
 (files
  (main.exe as hardcaml-workbench-init)
  (simulation_main.exe as hardcaml-workbench-simulation-setup)))
