(library
 (name hardcaml_workbench_setup)
 (modules
  asic_adoption
  config_migration
  initialization
  no_clobber
  project_discovery
  simulation_setup)
 (libraries
  core
  core_unix
  core_unix.filename_unix
  core_unix.signal_unix
  core_unix.sys_unix
  hardcaml_workbench_adapters
  hardcaml_workbench_project_integration
  hardcaml_workbench_protocol)
 (preprocess
  (pps ppx_jane))
 (lint
  (pps ppx_js_style)))

(executable
 (name main)
 (modules main)
 (public_name silver-init)
 (package hardcaml_workbench)
 (libraries core core_unix.command_unix hardcaml_workbench_setup)
 (preprocess
  (pps ppx_jane))
 (lint
  (pps ppx_js_style)))

(executable
 (name simulation_main)
 (modules simulation_main)
 (public_name silver-simulation-setup)
 (package hardcaml_workbench)
 (libraries core core_unix.command_unix hardcaml_workbench_setup)
 (preprocess
  (pps ppx_jane))
 (lint
  (pps ppx_js_style)))

(install
 (package hardcaml_workbench)
 (section bin)
 (files
  (main.exe as hardcaml-workbench-init)
  (simulation_main.exe as hardcaml-workbench-simulation-setup)))
