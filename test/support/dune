; Controlled Python clients only. Keep the compatibility import/help closure
; explicit so the tests run using sandbox inputs rather than the source checkout.
(rule
 (alias runtest)
 (deps
  (sandbox always)
  test_terminal.py
  __init__.py
  screen.py
  terminal.py
  ../../scripts/test-native-execution.py
   ../../scripts/test-retained-asic-dashboard.py
   ../../scripts/test-native-simulation.py
   ../../scripts/fixtures/simulation_fixture_wire.py
   ../../scripts/fixtures/testing_layout.py)
 (action
  (run timeout 30s python3 -B %{dep:test_terminal.py} -v)))
